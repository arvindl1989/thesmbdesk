---
// Wire this to MailerLite/Brevo: replace the form action with your
// provider's embedded form endpoint, or swap the whole block for
// their embed snippet.
---
<section class="newsletter" aria-label="Newsletter signup">
  <div class="newsletter-copy">
    <p class="eyebrow">The weekly entry</p>
    <h2>One useful thing for your business, every week</h2>
    <p>A short, practical email on marketing, tools and operations for Indian SMBs. No fluff, unsubscribe anytime.</p>
  </div>
  <form action="#" method="post" onsubmit="alert('Connect this form to your email provider'); return false;">
    <input type="email" name="email" placeholder="you@yourbusiness.in" required aria-label="Email address" />
    <button class="btn" type="submit">Join free</button>
  </form>
</section>
