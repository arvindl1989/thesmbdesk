---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const latest = posts.slice(0, 6);
---
<BaseLayout
  title="Practical growth guides for Indian small businesses"
  description="The SMB Desk publishes tested marketing, software and operations guides for Indian small businesses — written by a practitioner, not a content farm."
>
  <main>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">Marketing · Tools · Finance &amp; Ops · Growth</span>
        <h1>The working desk for Indian small businesses</h1>
        <p class="lede">
          Practical, tested guides on marketing, software and operations —
          written by a practitioner with a decade in the trade, not a content farm.
        </p>
      </div>
    </section>

    <div class="wrap">
      <div class="section-head">
        <h2>Latest from the desk</h2>
        <a href="/blog/">All guides →</a>
      </div>
      <div class="post-grid">
        {latest.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
          />
        ))}
      </div>

      <Newsletter />
    </div>
  </main>
</BaseLayout>
